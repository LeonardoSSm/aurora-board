{
  "name": "aurora-board",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aurora Board — workspace visual infinito, modular e extensível",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"npm:server\"",
    "dev:web": "vite",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "server:start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:report": "playwright show-report",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
