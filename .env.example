# Copie para .env e preencha apenas as chaves que você possui.
# As chaves ficam SOMENTE no servidor local (server/), nunca no frontend.
AURORA_API_PORT=8787

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meu Pluggy — uso pessoal, SOMENTE LEITURA (docs/finance/MEU_PLUGGY.md).
# Client ID/Secret da sua aplicação no Dashboard da Pluggy e os itemIds do conector MeuPluggy (separados por vírgula).
# Nunca cole esses valores em chat, issue ou commit: este arquivo (.env) é ignorado pelo Git.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
# 1 = computadores PAREADOS também podem ler os dados do Meu Pluggy (padrão: só este computador).
AURORA_PLUGGY_PAIRED_READ=
